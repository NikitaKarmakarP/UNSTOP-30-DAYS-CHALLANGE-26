#include <iostream>
#include <vector>
#include <deque>
using namespace std;

vector<int> calculatePeakReadings(int n, int k, const vector<int>& readings) {
    vector<int> peaks;
    deque<int> dq;

    for (int i = 0; i < n; i++) {
        while (!dq.empty() && dq.front() <= i - k)
            dq.pop_front();

        while (!dq.empty() && readings[dq.back()] <= readings[i])
            dq.pop_back();

        dq.push_back(i);

        if (i >= k - 1)
            peaks.push_back(readings[dq.front()]);
    }

    return peaks;
}

int main() {
    int n, k;
    cin >> n >> k;

    vector<int> readings(n);
    for (int i = 0; i < n; i++)
        cin >> readings[i];

    vector<int> result = calculatePeakReadings(n, k, readings);

    for (int i = 0; i < result.size(); i++) {
        cout << result[i];
        if (i != result.size() - 1)
            cout << " ";
    }

    return 0;
}
