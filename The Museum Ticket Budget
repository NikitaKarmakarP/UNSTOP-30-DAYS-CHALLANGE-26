#include <iostream>
#include <vector>
using namespace std;

int longestAffordableStreak(const vector<long long>& cost, int n, long long budget) {
    long long total = 0;
    int left = 0;
    int answer = 0;

    for (int right = 0; right < n; ++right) {
        total += cost[right];

        while (left <= right && total > budget) {
            total -= cost[left];
            ++left;
        }

        answer = max(answer, right - left + 1);
    }

    return answer;
}

int main() {
    int n;
    long long budget;

    cin >> n >> budget;

    vector<long long> cost(n);

    for (int i = 0; i < n; ++i) {
        cin >> cost[i];
    }

    cout << longestAffordableStreak(cost, n, budget) << endl;

    return 0;
}
