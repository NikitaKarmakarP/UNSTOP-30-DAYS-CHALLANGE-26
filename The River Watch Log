#include <iostream>
#include <vector>
#include <unordered_map>
#include <deque>
using namespace std;

void analyze_depth_readings(int n, int W, const vector<int>& depths) {
    unordered_map<int, int> cnt;
    deque<int> dq;

    for (int i = 0; i < n; ++i) {
        ++cnt[depths[i]];

        while (!dq.empty() && depths[dq.back()] < depths[i])
            dq.pop_back();

        dq.push_back(i);

        while (!dq.empty() && dq.front() <= i - W)
            dq.pop_front();

        if (i >= W - 1) {
            cout << depths[dq.front()] << ' ' << cnt.size() << '\n';

            int removed = depths[i - W + 1];

            if (--cnt[removed] == 0)
                cnt.erase(removed);
        }
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, W;
    cin >> n >> W;

    vector<int> depths(n);
    for (int i = 0; i < n; ++i)
        cin >> depths[i];

    analyze_depth_readings(n, W, depths);

    return 0;
}
